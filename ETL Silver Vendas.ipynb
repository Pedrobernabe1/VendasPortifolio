    "%sql\n",
    "CREATE OR REPLACE TABLE workspace.silver.stock AS\n",
    "SELECT\n",
    "  sku_code,\n",
    "  design_no,\n",
    "  stock,\n",
    "  TRIM(category)                                              AS category,\n",
    "  REGEXP_REPLACE(TRIM(category), '^[A-Z]{2} *: *', '')       AS category_norm,\n",
    "  size,\n",
    "  color\n",
    "FROM workspace.default.sale_report_raw"
   ]
  },
