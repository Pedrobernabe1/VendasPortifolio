   "source": [
    "%sql\n",
    "CREATE OR REPLACE TABLE workspace.silver.sales_international AS\n",
    "SELECT\n",
    "  TO_DATE(date, 'MM-dd-yy')     AS order_date,\n",
    "  months                        AS month_label,\n",
    "  customer,\n",
    "  style,\n",
    "  sku,\n",
    "  size,\n",
    "  TRY_CAST(pcs AS DOUBLE)       AS pcs,\n",
    "  TRY_CAST(rate AS DOUBLE)      AS rate,\n",
    "  TRY_CAST(gross_amt AS DOUBLE) AS gross_amt\n",
    "FROM workspace.default.international_sales_raw\n",
    "WHERE months RLIKE '^[A-Z][a-z]{2}-[0-9]{2}$'\n",
    "  AND date  RLIKE '^[0-9]{2}-[0-9]{2}-[0-9]{2}$'\n",
    "  AND TRY_CAST(gross_amt AS DOUBLE) IS NOT NULL"
   ]
  },
