    "%sql\n",
    "CREATE OR REPLACE TABLE workspace.silver.product_prices AS\n",
    "SELECT\n",
    "  sku,\n",
    "  style_id,\n",
    "  catalog,\n",
    "  category,\n",
    "  TRY_CAST(weight AS DOUBLE)         AS weight_kg,\n",
    "  TRY_CAST(tp AS DOUBLE)              AS cost_price_tp,\n",
    "  TRY_CAST(final_mrp_old AS DOUBLE)   AS final_mrp\n",
    "FROM workspace.default.price_list_may_2022_raw"
   ]
  },
